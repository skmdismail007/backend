generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id        String   @id @default(cuid())
  name      String
  category  String
  price     Decimal  @db.Decimal(10, 2)
  badge     String?
  image     String?
  short     String
  details   String
  specs     String[] @default([])
  includes  String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteItems QuoteItem[]

  @@index([category])
  @@index([isActive])
}

model Service {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("Website")
  price        Decimal  @db.Decimal(10, 2)
  timeline     String?
  description  String
  image        String?
  deliverables String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model Review {
  id         String   @id @default(cuid())
  name       String
  project    String
  rating     Int
  image      String?
  text       String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isApproved])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
}

model QuoteRequest {
  id        String      @id @default(cuid())
  name      String
  email     String
  phone     String
  note      String?
  status    String      @default("new")
  items     QuoteItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([email])
}

model QuoteItem {
  id             String       @id @default(cuid())
  quoteRequestId String
  productId      String?
  name           String
  quantity       Int
  price          Decimal      @db.Decimal(10, 2)
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteRequestId])
  @@index([productId])
}
